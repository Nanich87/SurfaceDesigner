<Project>
  <!-- Общи настройки за всички проекти в решението -->

  <PropertyGroup>
    <!-- В CI (GitHub Actions задава CI=true) всяко предупреждение, вкл. StyleCop, проваля компилацията.
         Локално остават предупреждения, за да не пречат по време на работа. -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.3.180" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>
</Project>
